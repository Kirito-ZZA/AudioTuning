APPViewer {
    min-width: 1280px;
    min-height: 720px;
}
/* Header */
Header {
    background-color: #197ccc;
}
Header#Header_title{
    background-color: #197ccc;
    margin-right: 20px;
}
/* QMessageBox  QInputDialog */
QMessageBox, QInputDialog {
    background-color: #fff;
    font-family: Microsoft YaHei;
}
QMessageBox QLabel, QInputDialog QLabel, QFileDialog QLabel {
    font-family: Microsoft YaHei;
}
QMessageBox QPushButton, QInputDialog QPushButton, QFileDialog QPushButton {
    min-height: 22px;
    min-width: 80px;
    border-radius: 3px;
    border: 1px solid #b2b2b2;
    font-family: Microsoft YaHei;
}
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover, QFileDialog QPushButton:hover {
    border: 1px solid #197ccc;
}
QMessageBox QPushButton:pressed, QInputDialog QPushButton:pressed, QFileDialog QPushButton:pressed {
    border: 2px solid #197ccc;
}
QInputDialog QLineEdit, QFileDialog QLineEdit {
    min-height: 22px;
    border-radius: 3px;
    border: 1px solid #b2b2b2;
    font-family: Microsoft YaHei;
    selection-background-color:#DEF0FE;
    selection-color:#386487;
}

/* TDeviceWidgetCustom */
TDeviceWidgetCustom {
    min-width: 360px;
    max-width: 360px;
    border: 1px solid #b2b2b2;
    border-radius: 6px;
    background-color: #fff;
}
TDeviceWidgetCustom QLabel {
    height: 32px;
    background-color: transparent;
    color: #747474;
    font-family: Microsoft YaHei;
    font-size: 15px;
    text-align: right;
}
TDeviceWidgetCustom #Title {
    min-width: 105px;
    max-height: 50px;
    border-radius: 6px;
    background-color: #006ec6;
    color: #fff;
    font-family: Microsoft YaHei;
    font-size: 24px;
}
TDeviceWidgetCustom #Center {
    background-color: #f3f3f3;
}
TDeviceWidgetCustom QComboBox, TDeviceWidgetCustom QLineEdit, TDeviceWidgetCustom QSpinBox {
    background-color: transparent;
    padding-right: 3px;
    height: 32px;
    border: 1px solid #747474;
    border-radius: 3px;
    font-family: Microsoft YaHei;
    font-size: 15px;
    color: #141414;
    text-align: center;
}
TDeviceWidgetCustom QComboBox QAbstractItemView {
    background-color: #f3f3f3;
    outline: none;/*取消选中虚线*/
    border: 1px solid #0061af;
    font-size: 15px;
    font-family: Microsoft YaHei;
    color: #141414;
}

TDeviceWidgetCustom #ConnBtn,TDeviceWidgetCustom #DisConnBtn {
    width: 100px;
    height: 36px;
    background-color: #f0f0f0;
    border: 1px solid #006ec6;
    border-radius: 18px;
    color: #006ec6;
    font-family: Microsoft YaHei;
    font-size: 16px;
    text-align: center;
}
TDeviceWidgetCustom #ConnBtn:hover,TDeviceWidgetCustom #DisConnBtn:hover {
    background-color: #acd0ed;
}
TDeviceWidgetCustom #ConnBtn:pressed,TDeviceWidgetCustom #DisConnBtn:pressed {
    background-color: #3089d1;
    color: #fff;
}
TDeviceWidgetCustom #ConnBtn:disabled,TDeviceWidgetCustom #DisConnBtn:disabled {
    background-color: #f0f0f0;
    border: none;
    color: #969696;
}
/* DataTableWidget */
DataTableWidget #TableView {
    background:#ffffff;
    border: none;
    font-size: 15px;
    font-family: Microsoft YaHei;
    color: #000;
    selection-background-color: #b3ddff;
    selection-color:#000;
    alternate-background-color: #eeeeee;
    gridline-color: #dcdcdc;
    outline: none;/*取消选中虚线*/
}
DataTableWidget QHeaderView::section {
    padding:3px;
    margin:0px;
    color: #000;
    background: #eeeeee;
    font: 12px 'Microsoft YaHei';
    border:1px solid #dcdcdc;
    border-left-width:0px;
    border-right-width:1px;
    border-top-width:0px;
    border-bottom-width:0px;
}
/* TTitleBtn */
TTitleBtn{
    background-color: #197ccc;
    border-radius: none;
    padding-top: 15px;
    padding-bottom: 5px;
    background-origin: content;
    background-position: top;
    background-repeat: no-repeat;
    width: 100px;
    height: 68px;
    text-align: bottom;
    font-family: Microsoft YaHei;
    font-size: 15px;
    color: #e6ffff;
}
TTitleBtn:hover {
    background-color: #3089d1;
}
TTitleBtn:pressed, TTitleBtn:checked {
    background-color: #3089d1;
    padding-bottom: 2px;
    border-bottom: 3px solid #acd0ed;
}

TTitleBtn_combo{
    background-color: #197ccc;
    border-radius: none;
    padding-top: 15px;
    padding-bottom: 5px;
    background-origin: content;
    background-position: top;
    background-repeat: no-repeat;
    width: 100px;
    height: 68px;
    text-align: bottom;
    font-family: Microsoft YaHei;
    font-size: 15px;
    color: #e6ffff;
}
TTitleBtn_combo:hover {
    background-color: #3089d1;
}
TTitleBtn_combo:pressed, TTitleBtn_combo:checked {
    background-color: #3089d1;
    padding-bottom: 2px;
    border-bottom: 3px;
}

/* QMenu{
    background-color: #3089d1;
} */

QMenu::item{
    background-color: #faf1f1;
    padding: 10px;
    padding-right: 15px;
    padding-left: 30px;
    /* height: 100px; */
    /* min-height: 140px;
    max-height: 140px; */
}

QMenu::separator{
    background-color: #8f8989;
    height: 2px;

}

QMenu::item:selected{
    background-color: #3089d1;
    /* min-height: 140px;
    max-height: 140px; */
}

/* QMenu::item::indicator{
    width: 24px;
    min-height: 140px;
    max-height: 140px;
} */

Header #wenjianBtn{
    background-image: url('resource/pic/wenjian.png');
}
Header #shebeiBtn{
    background-image: url('resource/pic/shebei.png');
}
Header #caiyangBtn{
    background-image: url('resource/pic/caiyang.png');
}
Header #chuangkouBtn{
    background-image: url('resource/pic/chuangkou.png');
}
Header #measBtn{
    background-image: url('resource/pic/meas.png');
}
Header #dataBtn{
    background-image: url('resource/pic/data.png');
}
Header #reportBtn{
    background-image: url('resource/pic/report.png');
}
Header #deviceBtn{
    background-image: url('resource/pic/device.png');
}
Header #schemeBtn{
    background-image: url('resource/pic/scheme.png');
}
Header #infoBtn{
    background-image: url('resource/pic/info.png');
}
Header #settingBtn{
    background-image: url('resource/pic/setting.png');
}
Header #HeaderSplitter1, Header #HeaderSplitter2, Header #HeaderSplitter3, Header #HeaderSplitter4{
    max-width: 1px;
    max-height: 44px;
    background-color: #4796d6;
}

