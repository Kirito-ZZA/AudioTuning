/* ============================================================
   AudioTuning 主题模板 —— 专业音频仪器风格
   本文件为模板：所有颜色以占位符表示，由 theme.py 渲染注入。
   全局字体统一 Microsoft YaHei；音频控制窗口按钮沿用蓝色样式。
   修改配色请改 theme.py 中的色板，不要在此写死颜色。
   ============================================================ */

*{
    outline: 0px;
    font-family: @font@;
}

/* ---------- 主窗口与基础容器 ---------- */
QMainWindow, AudioTuningApp {
    background-color: @panel_bg@;
}
AudioTuningApp {
    min-width: 1366px;
    min-height: 780px;
}
QDialog {
    background-color: @panel_bg_alt@;
}
QToolTip {
    background-color: @surface_2@;
    color: @text@;
    border: 1px solid @border@;
    padding: 4px 8px;
    font-family: @font@;
    font-size: 12px;
}

/* ---------- Dock ---------- */
QDockWidget {
    border: none;
    color: @text_secondary@;
}
QDockWidget::title {
    min-height: 36px;
    max-height: 36px;
    background-color: @surface@;
    border-bottom: 1px solid @border_subtle@;
    font-family: @font@;
    font-size: 15px;
    font-weight: bold;
    text-align: left;
}

/* ---------- 输入控件 ---------- */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: @input_bg@;
    padding-left: 6px;
    padding-right: 3px;
    max-height: 24px;
    border: 1px solid @border@;
    border-radius: 3px;
    font-family: @font@;
    font-size: 12px;
    color: @text@;
    text-align: center;
    selection-background-color: @selection_bg@;
    selection-color: @selection_text@;
}
QComboBox:hover, QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid @border_hover@;
}
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid @accent@;
}
QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: @disabled_bg@;
    border: 1px solid @border_subtle@;
    color: @text_disabled@;
}
QComboBox::down-arrow {
    image:url('@arrow_down@');
    width:10px;
    height:10px;
    right:2px;
}
QComboBox::drop-down {
    subcontrol-origin:padding;
    subcontrol-position:top right;
    width:15px;
    border-left-width:0px;
    border-left-style:solid;
    border-top-right-radius:3px;
    border-bottom-right-radius:3px;
    border-left-color:@border@;
}
QComboBox::drop-down:on{
    top:1px;
}
QComboBox QAbstractItemView {
    background-color: @surface@;
    border: 1px solid @accent@;
    font-size: 12px;
    font-family: @font@;
    color: @text@;
    text-align: center;
    selection-background-color: @selection_bg@;
    selection-color: @selection_text@;
    outline: none;
}

QDoubleSpinBox::up-button, QSpinBox::up-button{
    image:url('@arrow_up@');
    width:10px;
    height:6px;
    padding:2px 5px 0px 0px;
}
QDoubleSpinBox::down-button, QSpinBox::down-button{
    image:url('@arrow_down@');
    width:10px;
    height:6px;
    padding:0px 5px 2px 0px;
}

/* ---------- 通用按钮 ---------- */
QPushButton {
    background-color: @button_bg@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 3px;
    padding: 4px 12px;
    font-family: @font@;
}
QPushButton:hover {
    border: 1px solid @accent@;
    color: @text_bright@;
}
QPushButton:pressed {
    background-color: @button_pressed_bg@;
    border: 1px solid @accent@;
}
QPushButton:disabled {
    background-color: @disabled_bg@;
    border: 1px solid @border_subtle@;
    color: @text_disabled@;
}

/* ---------- 分组框 / 滚动区 ---------- */
QGroupBox {
    background-color: @panel_bg_alt@;
    border: 1px solid @border_subtle@;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 8px;
    font-family: @font@;
    font-size: 13px;
    color: @text@;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: @text_dim@;
    font-size: 12px;
}
QGroupBox::indicator {
    width: 14px;
    height: 14px;
}
QGroupBox::indicator:unchecked {
    border: 1px solid @border_hover@;
    border-radius: 3px;
    background-color: @input_bg@;
}
QGroupBox::indicator:checked {
    border: 1px solid @accent@;
    border-radius: 3px;
    background-color: @accent@;
}
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: @panel_bg@;
}
QSplitter::handle {
    background-color: @border_subtle@;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: @scrollbar_handle@;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_handle_hover@;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: @scrollbar_handle@;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_handle_hover@;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0px;
    width: 0px;
}

/* ---------- QMessageBox / QInputDialog / QFileDialog ---------- */
QMessageBox, QInputDialog {
    background-color: @panel_bg_alt@;
    font-family: @font@;
}
QMessageBox QLabel, QInputDialog QLabel, QFileDialog QLabel {
    font-family: @font@;
    color: @text@;
}
QMessageBox QPushButton, QInputDialog QPushButton, QFileDialog QPushButton {
    min-height: 22px;
    min-width: 80px;
    border-radius: 3px;
    border: 1px solid @border@;
    background-color: @button_bg@;
    color: @text@;
    font-family: @font@;
}
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover, QFileDialog QPushButton:hover {
    border: 1px solid @accent@;
}
QMessageBox QPushButton:pressed, QInputDialog QPushButton:pressed, QFileDialog QPushButton:pressed {
    border: 2px solid @accent@;
}
QInputDialog QLineEdit, QFileDialog QLineEdit {
    min-height: 22px;
    border-radius: 3px;
    border: 1px solid @border@;
    font-family: @font@;
    selection-background-color: @selection_bg@;
    selection-color: @selection_text@;
}

/* ---------- QMenu ---------- */
QMenu {
    background-color: @surface@;
    border: 1px solid @border@;
}
QMenu::item{
    background-color: transparent;
    padding: 8px;
    padding-right: 15px;
    padding-left: 30px;
    font-family: @font@;
    font-size: 14px;
    color: @text@;
}
QMenu::separator{
    background-color: @border@;
    height: 1px;
}
QMenu::item:selected{
    background-color: @selection_bg_soft@;
}

/* ---------- 表格 ---------- */
QTableWidget, DataTableWidget #TableView {
    background: @table_bg@;
    border: 1px solid @border_subtle@;
    font-size: 13px;
    font-family: @font@;
    color: @text@;
    selection-background-color: @selection_bg_soft@;
    selection-color: @selection_text@;
    alternate-background-color: @table_alt_bg@;
    gridline-color: @border_subtle@;
    outline: none;
}
QHeaderView::section,
DataTableWidget QHeaderView::section {
    padding: 3px;
    margin: 0px;
    color: @text_dim@;
    background: @header_view_bg@;
    font: 12px '@font@';
    border: 1px solid @border_subtle@;
    border-left-width: 0px;
    border-right-width: 1px;
    border-top-width: 0px;
    border-bottom-width: 0px;
}
QTableView QLineEdit:focus,QTableView QComboBox:focus,QTableView QSpinBox:focus,QTableView QDoubleSpinBox:focus,
QTableView QDateEdit:focus,QTableView QTimeEdit:focus,QTableView QDateTimeEdit:focus{
    border-width:0px;
    border-radius:0px;
}

/* ---------- TSubTitle ---------- */
TSubTitle {
    min-height: 36px;
    max-height: 36px;
    font-family: @font@;
    background-color: @surface@;
    border-bottom: 1px solid @border_subtle@;
}
TSubTitle #Title {
    padding-left: 30px;
    font-family: @font@;
    font-size: 15px;
    color: @accent@;
    background-color: transparent;
}

/* ---------- TSubBtnTitle ---------- */
TSubBtnTitle {
    padding-left: 30px;
    max-height: 36px;
    background-color: @surface@;
    border-bottom: 1px solid @border_subtle@;
}
TSubBtnTitle QPushButton {
    padding-left: 6px;
    padding-right: 6px;
    border: none;
    background-color: transparent;
    font-size: 15px;
    color: @text_dim@;
    font-family: @font@;
    text-align: center;
}
TSubBtnTitle QPushButton:hover {
    color: @accent@;
}
TSubBtnTitle QPushButton:checked {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid @accent@;
    color: @accent@;
}
TSubBtnTitle #CloseBtn {
    height: 36px;
    width: 36px;
    font-size: 18px;
    font-family: @font@;
    text-align: center;
    color: @text_disabled@;
}
TSubBtnTitle #CloseBtn:hover {
    color: @close_hover@;
}
TSubBtnTitle #CloseBtn:pressed {
    color: @close_pressed@;
}

/* ---------- TFileOpening ---------- */
TFileOpening {
    background-color: @panel_bg_alt@;
    padding-left: 30px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-family: @font@;
    border: none;
    border-bottom: 1px solid @accent@;
}
TFileOpening QLabel {
    background-color: transparent;
    font-family: @font@;
    font-size: 12px;
    color: @text_dim@;
    border: none;
}
TFileOpening QLineEdit {
    min-height: 22px;
    border-radius: 3px;
    border: 1px solid @border@;
    font-family: @font@;
    selection-background-color: @selection_bg@;
    selection-color: @selection_text@;
}
TFileOpening QPushButton {
    min-height: 22px;
    min-width: 80px;
    border-radius: 3px;
    background-color: @button_bg@;
    border: 1px solid @border@;
    font-family: @font@;
}
TFileOpening QPushButton:hover {
    border: 1px solid @accent@;
}
TFileOpening QPushButton:pressed {
    border: 2px solid @accent@;
}

/* ---------- Header（品牌蓝保留） ---------- */
AudioTuningApp #HeadDocker{
    min-height: 65px;
    max-height: 65px;
}
Header {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 @header_bg_start@, stop:1 @header_bg_end@);
}
Header#Header_title {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 @header_bg_start@, stop:1 @header_bg_end@);
    padding-right: 0px;
}
Header QProgressBar {
    background-color: @header_progress_track@;
    color: @header_progress_text@;
    max-width: 250px;
    max-height: 16px;
    padding-left: 0px;
    border: none;
    border-radius: 8px;
    font-family: @font@;
    text-align: center;
}
Header QProgressBar::chunk {
    background-color: @header_progress_chunk@;
    border-radius: 8px;
}
Header #StartStopBtn{
    min-height: 40px;
    border-radius: 20px;
    font-size: 15px;
    font-family: @font@;
    text-align: center;
    color: @startstop_text_stopped@;
    background-color: @startstop_bg@;
}
Header #StartStopBtn[started='true']{
    background-color: @startstop_bg@;
    color: @startstop_text_started@;
}
Header #StartStopBtn[started='false']{
    background-color: @startstop_bg@;
    color: @startstop_text_stopped@;
}

/* TTitleBtn / TTitleBtn_combo */
/* 图标与文字位置由按钮 paintEvent 自绘（图标顶部居中、文字底部居中），
   此处只负责背景与文字颜色等状态样式 */
TTitleBtn, TTitleBtn_combo {
    background-color: transparent;
    border-radius: none;
    width: 100px;
    height: 68px;
    font-family: @font@;
    font-size: 15px;
    color: @header_text@;
}
TTitleBtn:hover, TTitleBtn_combo:hover {
    background-color: @header_hover@;
    color: @header_text_hover@;
}
/* 选中/按下：3px 下划线指示（文字由代码绘制，位置不受影响） */
TTitleBtn:pressed, TTitleBtn:checked {
    background-color: @header_hover@;
    color: @header_text_hover@;
    border-bottom: 3px solid @header_underline@;
}
TTitleBtn_combo:pressed, TTitleBtn_combo:checked {
    background-color: @header_hover@;
    color: @header_text_hover@;
    border-bottom: 3px solid @header_underline@;
}
Header #HeaderSplitter1, Header #HeaderSplitter2, Header #HeaderSplitter3, Header #HeaderSplitter4{
    max-width: 1px;
    max-height: 44px;
    background-color: @header_splitter@;
}

/* ---------- Center 与四个页面 ---------- */
Center {
    background-color: @panel_bg@;
}
AudioProcessingPage, WaveformPage, SpectrumComparisonPage, HarmanComparisonPage {
    background-color: @panel_bg@;
}
Center TabBar {
    max-height: 40px;
    background-color: @tabbar_bg@;
    border-bottom: 1px solid @border_subtle@;
}
Center TabBar >QToolButton {
    border: none;
    background-color: transparent;
    color: @text_dim@;
}
Center TabBar >QToolButton:hover {
    background-color: @tab_hover_bg@;
}

/* TTabBtn */
TTabBtn {
    background-color: @tab_bg@;
    border-radius: none;
    font-family: @font@;
    font-weight: bold;
    font-size: 15px;
    color: @text_dim@;
    max-height: 40px;
    min-height: 40px;
    min-width: 120px;
    max-width: 120px;
    padding-right: 10px;
    text-align: center;
}
TTabBtn:hover {
    background-color: @tab_hover_bg@;
    color: @text_secondary@;
}
TTabBtn:pressed, TTabBtn:checked {
    background-color: @tab_checked_bg@;
    color: @text@;
    border-bottom: 3px solid @accent@;
}
TTabBtn #CloseBtn {
    max-height: 16px;
    max-width: 16px;
    background-color: transparent;
    font-family: @font@;
    font-size: 16px;
    color: @text_dim@;
}
TTabBtn #CloseBtn:hover {
    font-weight: bold;
    color: @text@;
}

/* ---------- 标签 ---------- */
TLabel {
    font-family: @font@;
    font-size: 16px;
    font-weight: bold;
    color: @text@;
}
QLabel {
    color: @text_secondary@;
}
NoiseMsgWidget #Label, SpectrumMsgWidget #Label {
    font-family: @font@;
    font-size: 15px;
    color: @text_dim@;
}

/* ---------- DeviceConnWidget / SamplingDockWidget / SamplingMsgDockWidget ---------- */
DeviceConnWidget, SamplingDockWidget, SamplingMsgDockWidget {
    background-color: @panel_bg_alt@;
    min-width: 250px;
    max-width: 250px;
    font-family: @font@;
    font-size: 15px;
    font-weight: bold;
}
DeviceConnWidget::close-button, DeviceConnWidget::float-button, SamplingDockWidget::close-button, SamplingDockWidget::float-button,
SamplingMsgDockWidget::close-button, SamplingMsgDockWidget::float-button {
    border: none;
    border-radius: 3px;
    icon-size: 64px;
}
DeviceConnWidget::close-button:hover, SamplingDockWidget::close-button:hover, SamplingMsgDockWidget::close-button:hover {
    background-color: @danger_hover@;
}
DeviceConnWidget::float-button:hover, SamplingDockWidget::float-button:hover, SamplingMsgDockWidget::float-button:hover {
    background-color: @selection_bg_soft@;
}
DeviceConnWidget::close-button:pressed, SamplingDockWidget::close-button:pressed, SamplingMsgDockWidget::close-button:pressed {
    background-color: @danger_pressed@;
}
DeviceConnWidget::float-button:pressed, SamplingDockWidget::float-button:pressed, SamplingMsgDockWidget::float-button:pressed {
    background-color: @accent@;
}
DeviceConnWidget >QWidget, SamplingDockWidget >QWidget, SamplingMsgDockWidget >QWidget {
    border-radius: 3px;
}
DeviceConnWidget::title, SamplingDockWidget::title, SamplingMsgDockWidget::title {
    border-radius: 3px;
    padding-left: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 15px;
    font-weight: bold;
    color: @text_secondary@;
    background-color: @surface@;
    border: 1px solid @border_subtle@;
}

/* ---------- DeviceWidget（音频控制窗口按钮沿用蓝色样式） ---------- */
/* 按钮仅 30px 高，字号降到 13px 减小文字像素边角毛刺 */
DeviceWidget QPushButton {
    height: 30px;
    width: 80px;
    border-radius: 3px;
    border: none;
    background-color: @device_btn_bg@;
    font-family: @font@;
    font-size: 13px;
    color: @device_btn_text@;
    text-align: center;
}
DeviceWidget QPushButton:hover {
    background-color: @device_btn_hover@;
}
DeviceWidget QPushButton:pressed {
    background-color: @device_btn_pressed@;
}
DeviceWidget QPushButton:disabled {
    background-color: @device_btn_disabled_bg@;
    color: @device_btn_disabled_text@;
}

/* ---------- SamplingWidget ---------- */
SamplingWidget >QLabel {
    font-family: @font@;
    font-size: 12px;
    color: @text_secondary@;
}
SamplingWidget >QComboBox {
    background-color: @input_bg@;
}
SamplingWidget >QComboBox:disabled, SamplingWidget >QLineEdit:disabled, SamplingWidget >QSpinBox:disabled, SamplingWidget >QDoubleSpinBox:disabled {
    background-color: @disabled_bg@;
    color: @text_disabled@;
}

/* ---------- SamplingMsgWidget ---------- */
SamplingMsgWidget >QLabel {
    font-family: @font@;
    font-size: 12px;
    color: @text_secondary@;
}
